<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU</Platforms>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <Company>S-100-BlueStack</Company>
    <Product>S100Framework</Product>
    <PackageId>S100Framework.Catalogues</PackageId>
    <RepositoryUrl>https://github.com/S-100-BlueStack/S100Framework</RepositoryUrl>
    <AssemblyVersion>5.0.0.0</AssemblyVersion>
    <Configurations>Debug</Configurations>    
    <PackageVersion>5.0.0</PackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JsonFlatten" Version="1.0.4" />
  </ItemGroup>

</Project>
